                "type": "text",
                "global_alpha": 1.0
            },
            {
                "id": "43f19e1bab8e4021bc416db83aab5a83",
                "content": "{\"styles\": [{\"fill\": {\"alpha\": 1.0, \"content\": {\"render_type\": \"solid\", \"solid\": {\"alpha\": 1.0, \"color\": [1, 1, 1]}}}, \"range\": [0, 15], \"size\": 8.0, \"bold\": true, \"italic\": false, \"underline\": false, \"strokes\": [{\"content\": {\"solid\": {\"alpha\": 1.0, \"color\": [0, 0, 0]}}, \"width\": 0.08000000000000002}]}], \"text\": \"내 인생 여드름 패치, 이건\"}",
                "typesetting": 0,
                "alignment": 1,
                "letter_spacing": 0.0,
