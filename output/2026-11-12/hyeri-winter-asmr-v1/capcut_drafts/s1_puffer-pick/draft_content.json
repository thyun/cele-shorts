            },
            {
                "id": "721ab4a004a247e48fc12fe9df6b482f",
                "content": "{\"styles\": [{\"fill\": {\"alpha\": 1.0, \"content\": {\"render_type\": \"solid\", \"solid\": {\"alpha\": 1.0, \"color\": [1, 1, 1]}}}, \"range\": [0, 16], \"size\": 8.0, \"bold\": true, \"italic\": false, \"underline\": false, \"strokes\": [{\"content\": {\"solid\": {\"alpha\": 1.0, \"color\": [0, 0, 0]}}, \"width\": 0.08000000000000002}]}], \"text\": \"최애 아이템으로 가져왔습니다.\"}",
                "typesetting": 0,
                "alignment": 1,
                "letter_spacing": 0.0,
